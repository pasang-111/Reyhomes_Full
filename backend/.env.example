SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-api-domain.com
DB_NAME=reyhomes
DB_USER=reyhomes
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
USE_SQLITE=False

# HTTPS / reverse proxy production settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# Local/disk media (Render paid disk: MEDIA_ROOT=/var/data/media, USE_CLOUDINARY=False, USE_S3=False)
MEDIA_ROOT=

# S3-compatible media (Cloudflare R2 recommended, or AWS S3).
# Set USE_S3=True after creating the bucket and filling the values below.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# R2: use "auto". AWS S3: e.g. ap-southeast-2
AWS_S3_REGION_NAME=auto
# R2 only: https://<account_id>.r2.cloudflarestorage.com  (leave blank for AWS S3)
AWS_S3_ENDPOINT_URL=
# Public hostname only, no https:// — e.g. pub-xxxxxxxx.r2.dev
AWS_S3_CUSTOM_DOMAIN=

# Cloudinary (free media) — preferred over S3 for free deploys
# Dashboard: https://console.cloudinary.com → Product env → API Keys
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Google Workspace / Gmail SMTP
# Use a Google App Password when 2-Step Verification is enabled.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hello@reyhomes.com.au
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=hello@reyhomes.com.au
CONTACT_NOTIFICATION_EMAIL=hello@reyhomes.com.au
EMAIL_TIMEOUT=20

# Public site origin for password-reset emails
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-frontend.vercel.app

# Optional API throttle rates
DRF_ANON_THROTTLE=120/min
DRF_USER_THROTTLE=300/min
